        <mxCell id="p2_vpc" parent="1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=11;container=1;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;" value="VPC 10.0.0.0/16 (public + private subnets, IGW, NAT)" vertex="1">
          <mxGeometry height="280" width="820" x="400" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2_eks" parent="p2_vpc" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" value="Amazon EKS control plane&#xa;+ managed node group (private subnets)" vertex="1">
          <mxGeometry height="61.25" width="61.25" x="360" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2e" edge="1" parent="1" source="p2_tf" style="endArrow=classic;html=1;fontSize=12;strokeColor=#9673a6;strokeWidth=2;" target="p2_cloud" value="terraform apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_integ" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" value="INTEGRATION POINT -&amp;gt; Phase 3: Terraform OUTPUTS (ECR repo URIs, EKS cluster name,&amp;nbsp;&lt;div&gt;and the OIDC deploy-role ARN) are exactly what the GitLab CI pipeline consumes to push images and deploy. terraform destroy removes all of this when idle.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="900" x="360" y="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 3 - CI/CD Pipeline" id="phase3">
    <mxGraphModel dx="1724" dy="715" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="PHASE 3 - CI/CD pipeline fills the Phase-2 infrastructure automatically" vertex="1">
          <mxGeometry height="30" width="780" x="280" y="15" as="geometry" />
        </mxCell>
        <mxCell id="p3_dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Developer&#xa;git push" vertex="1">
          <mxGeometry height="60" width="120" x="60" y="330" as="geometry" />
        </mxCell>
        <mxCell id="p3_pipe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#333333;verticalAlign=top;align=center;fontSize=13;fontStyle=1;" value="GitLab CI pipeline" vertex="1">
          <mxGeometry height="480" width="620" x="240" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p3_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="1. Lint + unit tests (Node: Jest / Python: pytest)&#xa;path filters: only changed app runs" vertex="1">
          <mxGeometry height="60" width="560" x="270" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="2. Build Docker image (multi-stage, non-root), tag = git SHA" vertex="1">
          <mxGeometry height="50" width="560" x="270" y="240" as="geometry" />
        </mxCell>
        <mxCell id="p3_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="3. OIDC assume AWS deploy role (NO static keys)" vertex="1">
          <mxGeometry height="50" width="560" x="270" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="4. Push image to ECR" vertex="1">
          <mxGeometry height="50" width="270" x="270" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p3_s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="5. Deploy to EKS (dev auto)&#xa;prod = manual approval gate" vertex="1">
          <mxGeometry height="50" width="270" x="560" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p3_ecr" parent="1" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" value="Amazon ECR" vertex="1">
          <mxGeometry height="70" width="70" x="950" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p3_eks" parent="1" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" value="Amazon EKS&#xa;dev + prod namespaces" vertex="1">
          <mxGeometry height="70" width="70" x="950" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p3e1" edge="1" parent="1" source="p3_dev" style="endArrow=classic;html=1;fontSize=11;strokeColor=#333;strokeWidth=2;" target="p3_pipe" value="triggers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e2" edge="1" parent="1" source="p3_s4" style="endArrow=classic;html=1;fontSize=11;strokeColor=#ED7100;strokeWidth=2;" target="p3_ecr" value="push">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e3" edge="1" parent="1" source="p3_s5" style="endArrow=classic;html=1;fontSize=11;strokeColor=#ED7100;strokeWidth=2;" target="p3_eks" value="deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_integ" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" value="INTEGRATION POINT -&amp;gt; Phase 2 &amp;amp; 4: the pipeline authenticates using the Phase-2 GitLab OIDC role, pushes to the Phase-2 ECR repos,&lt;div&gt;and deploys onto the Phase-2 EKS cluster. What it deploys (Deployments/Services) becomes the workloads that Phase 4 then hardens.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="760" x="240" y="630" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 4 - K8s Hardening" id="phase4">
    <mxGraphModel dx="1650" dy="684" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="PHASE 4 - Harden the workloads running on EKS" vertex="1">
          <mxGeometry height="30" width="600" x="330" y="15" as="geometry" />
        </mxCell>
        <mxCell id="p4_user" parent="1" style="sketch=0;outlineConnect=0;fillColor=#232F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" value="Internet Users" vertex="1">
