          <mxGeometry height="30" width="600" x="330" y="15" as="geometry" />
        </mxCell>
        <mxCell id="p5_eks" parent="1" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" value="EKS cluster + apps&#xa;(from Phases 3 &amp; 4)" vertex="1">
          <mxGeometry height="70" width="70" x="120" y="330" as="geometry" />
        </mxCell>
        <mxCell id="p5_cw" parent="1" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" value="CloudWatch&#xa;logs + Container Insights + dashboard" vertex="1">
          <mxGeometry height="70" width="70" x="420" y="150" as="geometry" />
        </mxCell>
        <mxCell id="p5_alarm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="CloudWatch Alarm&#xa;(5xx / pod restarts)" vertex="1">
          <mxGeometry height="60" width="180" x="640" y="155" as="geometry" />
        </mxCell>
        <mxCell id="p5_sns" parent="1" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" value="SNS -&gt; email alert" vertex="1">
          <mxGeometry height="70" width="70" x="900" y="150" as="geometry" />
        </mxCell>
        <mxCell id="p5_gd" parent="1" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;" value="GuardDuty&#xa;threat detection" vertex="1">
          <mxGeometry height="70" width="70" x="420" y="420" as="geometry" />
        </mxCell>
        <mxCell id="p5_sh" parent="1" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_hub;" value="Security Hub&#xa;central findings" vertex="1">
          <mxGeometry height="70" width="70" x="700" y="420" as="geometry" />
        </mxCell>
        <mxCell id="p5e1" edge="1" parent="1" source="p5_eks" style="endArrow=classic;html=1;fontSize=11;strokeColor=#E7157B;strokeWidth=2;" target="p5_cw" value="logs + metrics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e2" edge="1" parent="1" source="p5_cw" style="endArrow=classic;html=1;fontSize=11;strokeColor=#b85450;strokeWidth=2;" target="p5_alarm" value="breach threshold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e3" edge="1" parent="1" source="p5_alarm" style="endArrow=classic;html=1;fontSize=11;strokeColor=#E7157B;strokeWidth=2;" target="p5_sns" value="notify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e4" edge="1" parent="1" source="p5_eks" style="endArrow=classic;html=1;fontSize=11;strokeColor=#DD344C;strokeWidth=2;" target="p5_gd" value="account activity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e5" edge="1" parent="1" source="p5_gd" style="endArrow=classic;html=1;fontSize=11;strokeColor=#DD344C;strokeWidth=2;" target="p5_sh" value="findings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_integ" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" value="INTEGRATION POINT -&amp;gt; wraps Phases 1-4: everything running (apps, EKS, ALB) now emits logs/metrics to CloudWatch, alarms notify via SNS,&lt;div&gt;and GuardDuty + Security Hub give account-wide posture. This is the visibility layer over the whole platform. terraform destroy still tears it all down.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="810" x="120" y="560" as="geometry" />
        </mxCell>
