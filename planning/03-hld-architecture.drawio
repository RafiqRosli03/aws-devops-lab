        </mxCell>
        <mxCell id="e_user_igw" value="HTTPS" style="endArrow=classic;html=1;fontSize=11;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" parent="1" source="internet_user" target="igw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="675" />
              <mxPoint x="575" y="675" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Legend -->
        <mxCell id="legend" value="FLOW:  Developer git push -&gt; GitLab CI (lint/test/build) -&gt; OIDC assume IAM role (no static keys) -&gt; push image to ECR -&gt; terraform apply builds VPC/EKS/IAM/KMS/Secrets -&gt; deploy app to EKS.&#xa;RUNTIME:  Internet users -&gt; IGW -&gt; ALB (HTTPS ingress) -&gt; app pods on EKS worker nodes (private subnets, egress via NAT). Secrets from Secrets Manager, keys from KMS.&#xa;OBSERVABILITY/SECURITY:  CloudWatch (logs/metrics), GuardDuty (threat detection), Security Hub (central findings)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="360" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 1 - Apps + Docker" id="phase1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1t" value="PHASE 1 - Two Apps + Docker (LOCAL only, no AWS)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1_dev" value="Developer laptop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1_compose" value="docker-compose (local runtime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="640" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p1_node" value="App A - orders-node&#xa;Express REST API&#xa;Jest tests&#xa;multi-stage Dockerfile (non-root)&#xa;port 3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="150" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1_py" value="App B - users-python&#xa;FastAPI REST API&#xa;pytest tests&#xa;multi-stage Dockerfile (non-root)&#xa;port 8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="150" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1_img" value="Docker images built locally (small, non-root)&#xa;-&gt; ready to push to ECR in Phase 2/3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="330" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1e1" value="docker compose up" style="endArrow=classic;html=1;fontSize=11;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="p1_dev" target="p1_compose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_integ" value="INTEGRATION POINT -&gt; Phase 2/3: the two container images produced here are exactly what gets pushed to Amazon ECR and later deployed to EKS. Nothing in AWS yet." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="920" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 2 - Terraform / IaC" id="phase2">
    <mxGraphModel dx="1866" dy="878" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="PHASE 2 - Terraform builds ALL the AWS infrastructure" vertex="1">
