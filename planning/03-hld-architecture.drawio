        </mxCell>
        <mxCell id="p2_tf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="Terraform (modules + remote state in S3, native lock)" vertex="1">
