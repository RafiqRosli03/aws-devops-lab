        <mxCell id="p2_cloud" parent="1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;container=1;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;" value="AWS Cloud - ap-southeast-1 (created BY Terraform)" vertex="1">
          <mxGeometry height="680" width="900" x="360" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_iam" parent="1" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" value="IAM OIDC provider&#xa;+ deploy role" vertex="1">
          <mxGeometry height="60" width="60" x="400" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_ecr" parent="1" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" value="ECR&#xa;orders-node&#xa;users-python" vertex="1">
          <mxGeometry height="60" width="60" x="560" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_kms" parent="1" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" value="KMS" vertex="1">
          <mxGeometry height="60" width="60" x="720" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_sec" parent="1" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" value="Secrets Manager" vertex="1">
          <mxGeometry height="60" width="60" x="880" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_vpc" parent="1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=11;container=1;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;" value="VPC 10.0.0.0/16 (public + private subnets, IGW, NAT)" vertex="1">
          <mxGeometry height="570" width="820" x="400" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2_eks" parent="1" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" value="Amazon EKS control plane&#xa;+ managed node group (private subnets)" vertex="1">
          <mxGeometry height="70" width="70" x="740" y="420" as="geometry" />
        </mxCell>
        <mxCell id="p2e" edge="1" parent="1" source="p2_tf" style="endArrow=classic;html=1;fontSize=12;strokeColor=#9673a6;strokeWidth=2;" target="p2_cloud" value="terraform apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_integ" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" value="INTEGRATION POINT -&amp;gt; Phase 3: Terraform OUTPUTS&lt;div&gt;&amp;nbsp;(ECR repo URIs, EKS cluster name, and&lt;/div&gt;&lt;div&gt;&amp;nbsp;the OIDC deploy-role ARN) are exactly&lt;/div&gt;&lt;div&gt;&amp;nbsp;what the GitLab CI pipeline consumes to&lt;/div&gt;&lt;div&gt;&amp;nbsp;push images and deploy.&lt;/div&gt;&lt;div&gt;&amp;nbsp;terraform destroy removes all of this&lt;/div&gt;&lt;div&gt;&amp;nbsp;when idle.&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="240" x="50" y="540" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 3 - CI/CD Pipeline" id="phase3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3t" value="PHASE 3 - CI/CD pipeline fills the Phase-2 infrastructure automatically" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="15" width="780" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3_dev" value="Developer&#xa;git push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_pipe" value="GitLab CI pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#333333;verticalAlign=top;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="620" height="480" as="geometry" />
        </mxCell>
        <mxCell id="p3_s1" value="1. Lint + unit tests (Node: Jest / Python: pytest)&#xa;path filters: only changed app runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="160" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_s2" value="2. Build Docker image (multi-stage, non-root), tag = git SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="240" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_s3" value="3. OIDC assume AWS deploy role (NO static keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="310" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_s4" value="4. Push image to ECR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="380" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_s5" value="5. Deploy to EKS (dev auto)&#xa;prod = manual approval gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="380" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_ecr" value="Amazon ECR" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="950" y="230" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_eks" value="Amazon EKS&#xa;dev + prod namespaces" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1">
          <mxGeometry x="950" y="400" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3e1" value="triggers" style="endArrow=classic;html=1;fontSize=11;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="p3_dev" target="p3_pipe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e2" value="push" style="endArrow=classic;html=1;fontSize=11;strokeColor=#ED7100;strokeWidth=2;" edge="1" parent="1" source="p3_s4" target="p3_ecr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e3" value="deploy" style="endArrow=classic;html=1;fontSize=11;strokeColor=#ED7100;strokeWidth=2;" edge="1" parent="1" source="p3_s5" target="p3_eks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_integ" value="INTEGRATION POINT -&gt; Phase 2 &amp; 4: the pipeline authenticates using the Phase-2 GitLab OIDC role, pushes to the Phase-2 ECR repos, and deploys onto the Phase-2 EKS cluster. What it deploys (Deployments/Services) becomes the workloads that Phase 4 then hardens." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="630" width="780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 4 - K8s Hardening" id="phase4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4t" value="PHASE 4 - Harden the workloads running on EKS" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="15" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4_user" value="Internet Users" style="sketch=0;outlineConnect=0;fillColor=#232F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_alb" value="ALB Ingress&#xa;/orders -&gt; Node&#xa;/users -&gt; Python" style="sketch=0;outlineConnect=0;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_ns" value="EKS namespace (Pod Security Admission = restricted, default-deny NetworkPolicy)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=11;container=1;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="780" height="440" as="geometry" />
        </mxCell>
        <mxCell id="p4_node" value="orders-node Deployment&#xa;- non-root, read-only FS&#xa;- RBAC ServiceAccount&#xa;- resource limits + HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4_py" value="users-python Deployment&#xa;- non-root, read-only FS&#xa;- RBAC ServiceAccount&#xa;- resource limits + HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="170" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4_csi" value="Secrets Store CSI Driver -&gt; pulls from AWS Secrets Manager (no plaintext K8s secrets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="350" width="660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_sm" value="AWS Secrets Manager (from Phase 2)" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4e1" value="HTTPS" style="endArrow=classic;html=1;fontSize=11;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" parent="1" source="p4_user" target="p4_alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e2" value="/orders" style="endArrow=classic;html=1;fontSize=10;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" parent="1" source="p4_alb" target="p4_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e3" value="/users" style="endArrow=classic;html=1;fontSize=10;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" parent="1" source="p4_alb" target="p4_py">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e4" value="mount secrets" style="endArrow=classic;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p4_sm" target="p4_csi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_integ" value="INTEGRATION POINT -&gt; builds ON Phase 3: takes the Deployments the pipeline created and adds RBAC, default-deny network policies, non-root/read-only pod security, secrets from Secrets Manager, and HPA. Same apps, now production-shaped." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="1120" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 5 - Observability" id="phase5">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5t" value="PHASE 5 - Observability &amp; Cloud Security Posture" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="15" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5_eks" value="EKS cluster + apps&#xa;(from Phases 3 &amp; 4)" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_cw" value="CloudWatch&#xa;logs + Container Insights + dashboard" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_alarm" value="CloudWatch Alarm&#xa;(5xx / pod restarts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="155" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_sns" value="SNS -&gt; email alert" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="900" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_gd" value="GuardDuty&#xa;threat detection" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_sh" value="Security Hub&#xa;central findings" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_hub;" vertex="1" parent="1">
          <mxGeometry x="700" y="420" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5e1" value="logs + metrics" style="endArrow=classic;html=1;fontSize=11;strokeColor=#E7157B;strokeWidth=2;" edge="1" parent="1" source="p5_eks" target="p5_cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e2" value="breach threshold" style="endArrow=classic;html=1;fontSize=11;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="p5_cw" target="p5_alarm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e3" value="notify" style="endArrow=classic;html=1;fontSize=11;strokeColor=#E7157B;strokeWidth=2;" edge="1" parent="1" source="p5_alarm" target="p5_sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e4" value="account activity" style="endArrow=classic;html=1;fontSize=11;strokeColor=#DD344C;strokeWidth=2;" edge="1" parent="1" source="p5_eks" target="p5_gd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e5" value="findings" style="endArrow=classic;html=1;fontSize=11;strokeColor=#DD344C;strokeWidth=2;" edge="1" parent="1" source="p5_gd" target="p5_sh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_integ" value="INTEGRATION POINT -&gt; wraps Phases 1-4: everything running (apps, EKS, ALB) now emits logs/metrics to CloudWatch, alarms notify via SNS, and GuardDuty + Security Hub give account-wide posture. This is the visibility layer over the whole platform. terraform destroy still tears it all down." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="850" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
