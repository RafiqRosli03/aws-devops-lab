          <mxGeometry height="70" width="70" x="260" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p4_ns" parent="1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=11;container=1;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;" value="EKS namespace (Pod Security Admission = restricted, default-deny NetworkPolicy)" vertex="1">
          <mxGeometry height="440" width="780" x="420" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p4_node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="orders-node Deployment&#xa;- non-root, read-only FS&#xa;- RBAC ServiceAccount&#xa;- resource limits + HPA" vertex="1">
          <mxGeometry height="130" width="300" x="460" y="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_py" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="users-python Deployment&#xa;- non-root, read-only FS&#xa;- RBAC ServiceAccount&#xa;- resource limits + HPA" vertex="1">
          <mxGeometry height="130" width="300" x="820" y="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_csi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Secrets Store CSI Driver -&gt; pulls from AWS Secrets Manager (no plaintext K8s secrets)" vertex="1">
          <mxGeometry height="60" width="660" x="460" y="350" as="geometry" />
        </mxCell>
        <mxCell id="p4_sm" parent="1" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" value="AWS Secrets Manager (from Phase 2)" vertex="1">
          <mxGeometry height="60" width="60" x="160" y="440" as="geometry" />
        </mxCell>
        <mxCell id="p4e1" edge="1" parent="1" source="p4_user" style="endArrow=classic;html=1;fontSize=11;strokeColor=#8C4FFF;strokeWidth=2;" target="p4_alb" value="HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e2" edge="1" parent="1" source="p4_alb" style="endArrow=classic;html=1;fontSize=10;strokeColor=#8C4FFF;strokeWidth=2;" target="p4_node" value="/orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e3" edge="1" parent="1" source="p4_alb" style="endArrow=classic;html=1;fontSize=10;strokeColor=#8C4FFF;strokeWidth=2;" target="p4_py" value="/users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e4" edge="1" parent="1" source="p4_sm" style="endArrow=classic;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" target="p4_csi" value="mount secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_integ" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;spacingTop=6;" value="INTEGRATION POINT -&amp;gt; builds ON Phase 3: takes the Deployments the pipeline created and adds RBAC,&lt;div&gt;default-deny network policies, non-root/read-only pod security, secrets from Secrets Manager, and HPA. Same apps, now production-shaped.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="770" x="80" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Phase 5 - Observability" id="phase5">
    <mxGraphModel dx="1604" dy="665" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
